        },
        "autoChinese": {
          "type": "boolean",
          "description": "autoChinese 字段。"
        },
        "anonymous": {
          "type": "boolean",
          "description": "anonymous 字段。"
        },
        "player": {
          "type": "string",
          "description": "player 字段。"
        }
      },
      "additionalProperties": false,
      "description": "AppSettingsPatch：通过 Tauri 命令在前后端之间传输的数据对象。"
    },
    "ContentUpdateInfo": {
