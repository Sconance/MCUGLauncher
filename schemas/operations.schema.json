{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mcuglauncher.local/schemas/operations.schema.json",
  "title": "MCUGLauncher operations DTO",
  "description": "MCUGLauncher operations 领域 DTO。字段名使用 camelCase。",
  "$defs": {
    "ApiError": {
      "type": "object",
      "required": [
        "code",
        "message",
        "retryable"
      ],
      "properties": {
        "code": {
          "type": "string",
          "enum": [
            "VALIDATION_ERROR",
            "NOT_FOUND",
            "CONFLICT",
            "BUSY",
            "AUTH_REQUIRED",
            "NETWORK_ERROR",
            "IO_ERROR",
            "PLAN_EXPIRED",
            "INTERNAL_ERROR",
            "UNSUPPORTED"
          ],
          "description": "code 字段。"
        },
        "message": {
          "type": "string",
          "description": "message 字段。"
        },
        "retryable": {
          "type": "boolean",
          "description": "retryable 字段。"
        },
        "fieldErrors": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "description": "fieldErrors 字段。"
        }
      },
      "additionalProperties": false,
      "description": "ApiError：通过 Tauri 命令在前后端之间传输的数据对象。"
    },
    "ResourceKeyInfo": {
      "type": "object",
      "required": [
        "kind",
        "instanceId"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "description": "kind 字段。"
        },
        "instanceId": {
          "type": [
            "string",
            "null"
          ],
          "description": "instanceId 字段。"
        }
      },
      "additionalProperties": false,
      "description": "ResourceKeyInfo：通过 Tauri 命令在前后端之间传输的数据对象。"
    },
    "SavedInfo": {
      "type": "object",
      "required": [
        "message",
        "changed",
        "entityIds"
      ],
      "properties": {
        "message": {
          "type": "string",
          "description": "message 字段。"
        },
        "changed": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ResourceKeyInfo"
          },
          "description": "changed 字段。"
        },
        "entityIds": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "entityIds 字段。"
        }
      },
      "additionalProperties": false,
      "description": "SavedInfo：通过 Tauri 命令在前后端之间传输的数据对象。"
    },
    "ResourceSnapshot": {
      "type": "object",
      "required": [
        "epoch",
        "revision",
        "data"
      ],
      "properties": {
        "epoch": {
          "type": "string",
          "minLength": 1,
          "description": "epoch 字段。"
        },
        "revision": {
          "type": "integer",
          "minimum": 0,
          "description": "revision 字段。"
        },
        "data": {
          "description": "data 字段。"
        }
      },
      "additionalProperties": false,
      "description": "ResourceSnapshot：通过 Tauri 命令在前后端之间传输的数据对象。"
    },
    "UninstallPreviewInfo": {
      "type": "object",
      "required": [
        "planId",
        "targetId",
        "targetRevision",
        "expiresAt",
        "name",
        "notice",
        "paths",
        "shared"
      ],
      "properties": {
        "planId": {
          "type": "string",
          "description": "planId 字段。"
        },
        "targetId": {
          "type": "string",
          "description": "targetId 字段。"
        },
        "targetRevision": {
          "type": "integer",
          "description": "targetRevision 字段。"
        },
        "expiresAt": {
          "type": "string",
          "format": "date-time",
          "description": "expiresAt 字段。"
        },
        "name": {
          "type": "string",
          "description": "name 字段。"
        },
        "notice": {
          "type": "string",
          "description": "notice 字段。"
        },
        "paths": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "paths 字段。"
        },
        "shared": {
          "type": "boolean",
          "description": "shared 字段。"
        }
      },
      "additionalProperties": false,
      "description": "UninstallPreviewInfo：通过 Tauri 命令在前后端之间传输的数据对象。"
    }
  }
}
