{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mcuglauncher.local/schemas/launcher.schema.json",
  "title": "MCUGLauncher V2 DTO",
  "description": "Tauri invoke 命令使用的前后端共享数据传输对象。字段名使用 camelCase。",
  "$defs": {
    "ApiError": {
      "type": "object",
      "required": ["code", "message", "retryable"],
      "properties": {
        "code": { "type": "string", "enum": ["VALIDATION_ERROR", "NOT_FOUND", "CONFLICT", "BUSY", "AUTH_REQUIRED", "NETWORK_ERROR", "IO_ERROR", "PLAN_EXPIRED", "INTERNAL_ERROR", "UNSUPPORTED"] },
        "message": { "type": "string" },
        "retryable": { "type": "boolean" },
        "fieldErrors": { "type": "object", "additionalProperties": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "ResourceKeyInfo": {
      "type": "object",
      "required": ["kind", "instanceId"],
      "properties": {
        "kind": { "type": "string" },
        "instanceId": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "SavedInfo": {
      "type": "object",
      "required": ["message", "changed", "entityIds"],
      "properties": {
        "message": { "type": "string" },
        "changed": { "type": "array", "items": { "$ref": "#/$defs/ResourceKeyInfo" } },
        "entityIds": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "ResourceSnapshot": {
      "type": "object",
      "required": ["epoch", "revision", "data"],
      "properties": {
        "epoch": { "type": "string", "minLength": 1 },
        "revision": { "type": "integer", "minimum": 0 },
        "data": {}
      },
      "additionalProperties": false
    },
    "LauncherOverview": {
      "type": "object",
      "required": ["appVersion", "selectedInstanceId", "activeAccountId"],
      "properties": {
        "appVersion": { "type": "string" },
        "selectedInstanceId": { "type": ["string", "null"] },
        "activeAccountId": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "InstanceInfo": {
      "type": "object",
      "required": ["id", "name", "displayName", "loader", "minecraft"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "displayName": { "type": "string" },
        "loader": { "type": "string" },
        "minecraft": { "type": "string" },
        "mods": { "type": "integer", "minimum": 0 },
        "updates": { "type": "integer", "minimum": 0 },
        "isPlaceholder": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "InstanceCatalogInfo": {
      "type": "object",
      "required": ["items", "versionGroups"],
      "properties": {
        "items": { "type": "array", "items": { "$ref": "#/$defs/InstanceInfo" } },
        "versionGroups": { "type": "array" }
      },
      "additionalProperties": false
    },
    "ModInfo": {
      "type": "object",
      "required": ["id", "name", "file", "version", "enabled", "path", "size"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "file": { "type": "string" },
        "version": { "type": "string" },
        "enabled": { "type": "boolean" },
        "path": { "type": "string" },
        "size": { "type": "integer" }
      },
      "additionalProperties": false
    },
    "AccountInfo": {
      "type": "object",
      "required": ["id", "kind", "player", "status"],
      "properties": {
        "id": { "type": "string" },
        "kind": { "type": "string", "enum": ["microsoft", "mua", "offline"] },
        "player": { "type": "string" },
        "status": { "type": "string", "enum": ["ready", "expired", "invalid"] }
      },
      "additionalProperties": false
    },
    "SavedServerInfo": {
      "type": "object",
      "required": ["id", "name", "address", "instanceId"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "address": { "type": "string" },
        "instanceId": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "FavoriteInfo": {
      "type": "object",
      "required": ["id", "kind", "name", "description"],
      "properties": {
        "id": { "type": "string" },
        "kind": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" }
      },
      "additionalProperties": false
    },
    "SettingsInfo": {
      "type": "object",
      "required": ["root", "gameRoots", "java", "width", "height", "ram", "autoMemory", "anonymous", "dataSources", "dataSourceMode", "autoChinese"],
      "properties": {
        "root": { "type": "string" },
        "gameRoots": { "type": "array", "items": { "type": "string" } },
        "java": { "type": "string" },
        "width": { "type": "integer" },
        "height": { "type": "integer" },
        "ram": { "type": "integer" },
        "autoMemory": { "type": "boolean" },
        "anonymous": { "type": "boolean" },
        "hasCommunityKey": { "type": "boolean" },
        "hasAdminKey": { "type": "boolean" },
        "skinStation": { "type": "string" },
        "cape": { "type": "string" },
        "dataSources": { "type": "object" },
        "defaultDataSources": { "type": "object" },
        "customDataSources": { "type": "object" },
        "dataSourceMode": { "type": "string" },
        "autoChinese": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "TaskInfo": {
      "type": "object",
      "required": ["id", "kind", "instanceId", "status", "phase", "allowedActions", "createdAt", "updatedAt"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "kind": { "type": "string" },
        "instanceId": { "type": ["string", "null"] },
        "status": { "type": "string", "enum": ["queued", "running", "paused", "cancelling", "succeeded", "failed", "cancelled"] },
        "phase": { "type": "string" },
        "progress": { "type": ["object", "null"] },
        "allowedActions": { "type": "array", "items": { "type": "string" } },
        "error": { "anyOf": [{ "$ref": "#/$defs/ApiError" }, { "type": "null" }] },
        "result": { "type": ["object", "null"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "additionalProperties": false
    },
    "GameSessionInfo": {
      "type": "object",
      "required": ["sessionId", "instanceId", "accountId", "status", "pid", "exitCode", "error"],
      "properties": {
        "sessionId": { "type": "string" },
        "instanceId": { "type": "string" },
        "accountId": { "type": "string" },
        "status": { "type": "string", "enum": ["preparing", "starting", "running", "stopping", "exited", "failed"] },
        "pid": { "type": ["integer", "null"] },
        "exitCode": { "type": ["integer", "null"] },
        "error": { "anyOf": [{ "$ref": "#/$defs/ApiError" }, { "type": "null" }] }
      },
      "additionalProperties": false
    },
    "LoginSessionInfo": {
      "oneOf": [
        { "type": "object", "required": ["state", "authSessionId", "authorizationUrl"], "properties": { "state": { "const": "awaitingAuthorization" }, "authSessionId": { "type": "string" }, "authorizationUrl": { "type": "string" } }, "additionalProperties": false },
        { "type": "object", "required": ["state", "authSessionId", "profiles"], "properties": { "state": { "const": "awaitingProfile" }, "authSessionId": { "type": "string" }, "profiles": { "type": "array" } }, "additionalProperties": false },
        { "type": "object", "required": ["state", "authSessionId", "accountId"], "properties": { "state": { "const": "succeeded" }, "authSessionId": { "type": "string" }, "accountId": { "type": "string" } }, "additionalProperties": false },
        { "type": "object", "required": ["state", "authSessionId", "error"], "properties": { "state": { "const": "failed" }, "authSessionId": { "type": "string" }, "error": { "$ref": "#/$defs/ApiError" } }, "additionalProperties": false },
        { "type": "object", "required": ["state", "authSessionId"], "properties": { "state": { "enum": ["cancelled", "expired"] }, "authSessionId": { "type": "string" } }, "additionalProperties": false }
      ]
    },
    "LaunchAcceptedInfo": {
      "type": "object",
      "required": ["sessionId", "taskId"],
      "properties": { "sessionId": { "type": "string" }, "taskId": { "type": "string" } },
      "additionalProperties": false
    },
    "LaunchOptionsInfo": {
      "type": "object",
      "required": ["requestId", "token", "instanceId", "displayName", "inherited", "settings"],
      "properties": {
        "requestId": { "type": "string" },
        "token": { "type": "string" },
        "instanceId": { "type": "string" },
        "displayName": { "type": "string" },
        "inherited": { "type": "boolean" },
        "settings": { "type": "object" }
      },
      "additionalProperties": false
    },
    "LoaderListInfo": {
      "type": "object",
      "required": ["minecraftVersion", "loader", "versions"],
      "properties": { "minecraftVersion": { "type": "string" }, "loader": { "type": "string" }, "versions": { "type": "array", "items": { "type": "string" } } },
      "additionalProperties": false
    },
    "UninstallPreviewInfo": {
      "type": "object",
      "required": ["planId", "targetId", "targetRevision", "expiresAt", "name", "notice", "paths", "shared"],
      "properties": { "planId": { "type": "string" }, "targetId": { "type": "string" }, "targetRevision": { "type": "integer" }, "expiresAt": { "type": "string", "format": "date-time" }, "name": { "type": "string" }, "notice": { "type": "string" }, "paths": { "type": "array", "items": { "type": "string" } }, "shared": { "type": "boolean" } },
      "additionalProperties": false
    }
  }
}
