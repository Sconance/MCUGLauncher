<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="MCUGLauncher.Avalonia.ShellWindow"
        Title="MCUG Launcher"
        Width="1200" Height="780"
        MinWidth="1130" MinHeight="640"
        Background="{StaticResource AppBg}"
        SystemDecorations="BorderOnly"
        WindowStartupLocation="CenterScreen">
    <Grid x:Name="ShellRoot" RowDefinitions="52,*">
        <Border x:Name="TitleBar"
                Background="#FFFFFF"
                BorderBrush="{StaticResource AppLine}"
                BorderThickness="0,0,0,1"
                PointerPressed="OnTitleBarPointerPressed"
                DoubleTapped="OnTitleBarDoubleTapped">
            <Grid ColumnDefinitions="220,*,Auto">
                <StackPanel Orientation="Horizontal" Spacing="10" Margin="18,0,0,0" VerticalAlignment="Center">

                    <TextBlock Text="MCUG Launcher" FontSize="16" FontWeight="Bold" Foreground="#1B3044"
                               VerticalAlignment="Center" />
                    <TextBlock x:Name="BrandVersion" Text="0.22.3" FontSize="9.5" Foreground="#646D75"
                               VerticalAlignment="Bottom" Margin="0,0,0,14" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="3" VerticalAlignment="Center">
                    <Button x:Name="HomeButton" Classes="topnav" AutomationProperties.Name="启动">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <Svg Path="/Assets/LaunchIcon.svg" Height="16" Width="16" />
                            <TextBlock Text="启动" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="DownloadButton" Classes="topnav" AutomationProperties.Name="下载">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <Svg Path="/Assets/DownloadIcon.svg" Height="16" Width="16" />
                            <TextBlock Text="下载" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="SettingsButton" Classes="topnav" AutomationProperties.Name="设置">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <Svg Path="/Assets/SettingsIcon.svg" Height="16" Width="16" />
                            <TextBlock Text="设置" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8"
                            Margin="0,0,8,0">
                    <Button x:Name="MinimizeButton" Classes="titlebarbtn" Click="OnMinimizeWindow"
                            AutomationProperties.Name="最小化">
                        <Svg Path="/Assets/MinimizeIcon.svg" Height="24" Width="24" />
                    </Button>
                    <Button x:Name="MaximizeButton" Classes="titlebarbtn" Click="OnMaximizeWindow"
                            AutomationProperties.Name="最大化">
                        <Svg Path="/Assets/MaximizeIcon.svg" Height="24" Width="24" />
                    </Button>
                    <Button x:Name="CloseButton" Classes="titlebarbtn close" Click="OnCloseWindow"
                            AutomationProperties.Name="关闭">
                        <Svg Path="/Assets/CloseIcon.svg" Height="24" Width="24" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!--
            这里不再留内边距：页面自己带 Margin="20,20,3,20"，
            这样页面内的覆盖层（如首页的服务器弹窗）才能铺满标题栏以下的整块区域。
            右 3 的含义仍是"滚动条到页面右边界"，配合 ScrollViewer.Padding=0,0,11,0，
            卡片到窗口边 = 3 + 滚动条列(6) + 11。
        -->
        <Border Grid.Row="1">
            <ContentControl x:Name="PageHost"
                            HorizontalContentAlignment="Stretch"
                            VerticalContentAlignment="Stretch" />
        </Border>

        <Border x:Name="ToastLayer"
                Grid.RowSpan="2"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Margin="24"
                Padding="14,10"
                CornerRadius="8"
                Background="{StaticResource AppSidebar}"
                IsVisible="False">
            <TextBlock x:Name="ToastText" Foreground="White" TextWrapping="Wrap" MaxWidth="420" />
        </Border>
    </Grid>
</Window>
