<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="MCUGLauncher.Avalonia.ShellWindow"
        Title="MCUG Launcher"
        Width="1100" Height="720"
        MinWidth="900" MinHeight="600"
        Background="#F3F7F9"
        WindowStartupLocation="CenterScreen">
  <Grid ColumnDefinitions="220,*">
    <Border Background="#123247" Padding="14">
      <StackPanel Spacing="10">
        <TextBlock Text="MCUG Launcher" Foreground="White" FontSize="20" FontWeight="Bold" />
        <TextBlock Text="原生 Avalonia 界面" Foreground="#9FC4D8" FontSize="12" />
        <Button x:Name="HomeButton" Content="启动" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" />
        <Button x:Name="AccountButton" Content="账号" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" />
        <Button x:Name="TasksButton" Content="任务" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" />
        <Button x:Name="SettingsButton" Content="设置" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" />
        <Button x:Name="ClassicButton" Content="经典界面（WebView）" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" />
      </StackPanel>
    </Border>
    <ScrollViewer Grid.Column="1">
      <StackPanel x:Name="Content" Margin="24" Spacing="12" />
    </ScrollViewer>
  </Grid>
</Window>
