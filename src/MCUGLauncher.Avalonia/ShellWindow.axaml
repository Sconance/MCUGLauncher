<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="MCUGLauncher.Avalonia.ShellWindow"
        Title="MCUG Launcher"
        Width="1100" Height="720"
        MinWidth="900" MinHeight="600"
        Background="{StaticResource AppBg}"
        WindowStartupLocation="CenterScreen">
  <Grid ColumnDefinitions="220,*">
    <Border Background="{StaticResource AppSidebar}" Padding="14">
      <StackPanel Spacing="10">
        <TextBlock Text="MCUG Launcher" Foreground="White" FontSize="20" FontWeight="Bold" />
        <TextBlock Text="原生 Avalonia 界面" Foreground="{StaticResource AppSidebarText}" FontSize="12" />
        <Button x:Name="HomeButton" Classes="nav" Content="启动" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" />
        <Button x:Name="MaintenanceButton" Classes="nav" Content="实例" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" />
        <Button x:Name="DownloadButton" Classes="nav" Content="下载" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" />
        <Button x:Name="AccountButton" Classes="nav" Content="账号" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" />
        <Button x:Name="TasksButton" Classes="nav" Content="任务" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" />
        <Button x:Name="GamesButton" Classes="nav" Content="游戏" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" />
        <Button x:Name="BookmarksButton" Classes="nav" Content="收藏" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" />
        <Button x:Name="CommunityButton" Classes="nav" Content="社区" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" />
        <Button x:Name="SettingsButton" Classes="nav" Content="设置" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" />
      </StackPanel>
    </Border>
    <Border Grid.Column="1" Background="{StaticResource AppCard}" CornerRadius="16" Margin="18" Padding="20">
      <ContentControl x:Name="PageHost"
                      HorizontalContentAlignment="Stretch"
                      VerticalContentAlignment="Stretch" />
    </Border>
    <Border x:Name="ToastLayer"
            Grid.ColumnSpan="2"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            Margin="24"
            Padding="14,10"
            CornerRadius="10"
            Background="{StaticResource AppSidebar}"
            IsVisible="False">
      <TextBlock x:Name="ToastText" Foreground="White" TextWrapping="Wrap" MaxWidth="420" />
    </Border>
  </Grid>
</Window>
