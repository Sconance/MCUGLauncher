<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="MCUGLauncher.Avalonia.Views.InstancePickerView">
    <Border Classes="card" Padding="16">
        <Grid RowDefinitions="Auto,Auto,Auto,*" RowSpacing="10">
            <Grid ColumnDefinitions="*,Auto,Auto">
                <StackPanel Spacing="2">
                    <TextBlock Text="选择实例" Classes="h2" />
                    <TextBlock x:Name="PickerSummary" Classes="muted" TextWrapping="Wrap" />
                </StackPanel>
                <Button x:Name="RefreshVersionsButton" Grid.Column="1" Content="刷新版本" Classes="link"
                        VerticalAlignment="Center" />
                <Button x:Name="ClosePickerButton" Grid.Column="2" Content="收起" Classes="soft" Height="30"
                        Margin="10,0,0,0" VerticalAlignment="Center" />
            </Grid>

            <TextBox x:Name="PickerSearch" Grid.Row="1" Watermark="搜索实例名、版本或加载器" />

            <TextBlock x:Name="PickerStatus" Grid.Row="2" Classes="status" IsVisible="False" />

            <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          AllowAutoHide="False">
                <StackPanel x:Name="GroupPanel" Spacing="10" />
            </ScrollViewer>
        </Grid>
    </Border>
</UserControl>
