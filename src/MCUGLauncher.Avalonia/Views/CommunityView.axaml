<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="MCUGLauncher.Avalonia.Views.CommunityView">
  <Grid RowDefinitions="Auto,*">
    <StackPanel Spacing="6">
      <TextBlock Text="社区管理" Classes="pageTitle" />
      <TextBlock Text="管理员发布公告；内容会先保存到本机，配置写入接口后同步到社区数据源。"
                 Classes="muted" TextWrapping="Wrap" />
    </StackPanel>
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,10,0,0">
      <StackPanel Spacing="14">
        <Border Classes="card">
          <StackPanel Spacing="8">
            <TextBlock Text="管理员身份" Classes="h2" />
            <TextBlock x:Name="AdminHint" Classes="muted" TextWrapping="Wrap" />
            <Grid ColumnDefinitions="*,Auto">
              <TextBox x:Name="AdminKeyBox" PasswordChar="●" Watermark="首次输入即设置本机管理员密钥" />
              <Button x:Name="VerifyAdminButton" Grid.Column="1" Content="验证" Classes="ghost" Margin="8,0,0,0" />
            </Grid>
            <TextBlock x:Name="AdminStatus" Classes="status" TextWrapping="Wrap" />
          </StackPanel>
        </Border>

        <Border Classes="card">
          <StackPanel Spacing="8">
            <TextBlock Text="发布公告" Classes="h2" />
            <TextBlock Text="标题" FontWeight="SemiBold" />
            <TextBox x:Name="TitleBox" Watermark="公告标题" />
            <TextBlock Text="正文" FontWeight="SemiBold" />
            <TextBox x:Name="BodyBox" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="110"
                     Watermark="公告正文" />
            <TextBlock Text="过期时间（可选）" FontWeight="SemiBold" />
            <TextBox x:Name="ExpiresBox" Watermark="例如 2026-12-31 23:59" />
            <TextBlock Text="配图（可选）" FontWeight="SemiBold" />
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button x:Name="PickImageButton" Content="选择图片" Classes="ghost" />
              <Button x:Name="ClearImageButton" Content="移除图片" Classes="ghost" IsEnabled="False" />
              <TextBlock x:Name="ImageLabel" Classes="muted" VerticalAlignment="Center" />
            </StackPanel>
            <Image RenderOptions.BitmapInterpolationMode="None" x:Name="ImagePreview" MaxHeight="160" Stretch="Uniform" HorizontalAlignment="Left" />
            <Button x:Name="PublishButton" Content="保存并发布" Classes="primary" HorizontalAlignment="Left" />
            <TextBlock x:Name="PublishStatus" Classes="status" TextWrapping="Wrap" />
          </StackPanel>
        </Border>

        <Border Classes="card">
          <StackPanel Spacing="8">
            <TextBlock Text="当前公告" Classes="h2" />
            <StackPanel x:Name="AnnouncementsPanel" Spacing="6" />
          </StackPanel>
        </Border>

        <Border Classes="card">
          <StackPanel Spacing="8">
            <TextBlock Text="管理公告" Classes="h2" />
            <TextBlock Text="删除会重写本机公告列表，保留未删除项及其原始字段；需要管理员密钥。"
                       Classes="muted" TextWrapping="Wrap" />
            <StackPanel x:Name="AnnouncementManagePanel" Spacing="6" />
          </StackPanel>
        </Border>

        <Border Classes="card">
          <StackPanel Spacing="8">
            <TextBlock Text="管理推荐" Classes="h2" />
            <TextBlock Text="删除会重写本机推荐列表，保留未删除项及其原始字段；需要管理员密钥。"
                       Classes="muted" TextWrapping="Wrap" />
            <StackPanel x:Name="RecommendationManagePanel" Spacing="6" />
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
