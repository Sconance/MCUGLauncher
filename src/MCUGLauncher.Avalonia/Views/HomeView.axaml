<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="MCUGLauncher.Avalonia.Views.HomeView">
  <StackPanel Spacing="12">
    <TextBlock x:Name="Account" FontSize="20" FontWeight="Bold" />
    <TextBlock x:Name="Player" />
    <TextBlock x:Name="Version" />
    <TextBlock Text="实例" FontSize="18" FontWeight="Bold" Margin="0,12,0,0" />
    <StackPanel x:Name="Instances" Spacing="8" />
  </StackPanel>
</UserControl>
