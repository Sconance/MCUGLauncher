<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="MCUGLauncher.Avalonia.Views.AnnouncementWindow"
        Title="公告"
        Width="820"
        Height="720"
        MinWidth="480"
        MinHeight="420"
        WindowStartupLocation="CenterOwner"
        Background="White">
    <Grid Margin="20" RowDefinitions="Auto,*,Auto" RowSpacing="12">
        <StackPanel Spacing="4">
            <TextBlock x:Name="AnnouncementTitle" Classes="h2" TextWrapping="Wrap" />
            <TextBlock x:Name="AnnouncementMeta" Classes="muted" TextWrapping="Wrap" />
        </StackPanel>
        <ContentControl x:Name="MarkdownHost" Grid.Row="1" />
        <Button x:Name="CloseButton" Grid.Row="2" Content="关闭" Classes="ghost"
                HorizontalAlignment="Right" />
    </Grid>
</Window>
