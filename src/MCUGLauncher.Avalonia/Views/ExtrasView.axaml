<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="MCUGLauncher.Avalonia.Views.ExtrasView">
    <Grid ColumnDefinitions="190,*" Margin="20,20,3,20">
        <Border Background="{StaticResource AppSide}" CornerRadius="12" Padding="8" VerticalAlignment="Stretch">
            <StackPanel Spacing="4">
                <TextBlock Text="更多" FontSize="18" FontWeight="Bold" Margin="8,6,8,10" />
                <ListBox x:Name="Nav" Background="Transparent" BorderThickness="0"
                         SelectionChanged="OnNavSelectionChanged">
                    <ListBoxItem Content="实例" Tag="instances" />
                    <ListBoxItem Content="账号与皮肤" Tag="account" />
                    <ListBoxItem Content="下载任务" Tag="tasks" />
                    <ListBoxItem Content="运行中的游戏" Tag="games" />
                    <ListBoxItem Content="我的收藏" Tag="bookmarks" />
                    <ListBoxItem Content="社区管理" Tag="community" />
                </ListBox>
            </StackPanel>
        </Border>

        <ContentControl x:Name="PageHost" Grid.Column="1" Margin="18,0,0,0"
                        HorizontalContentAlignment="Stretch"
                        VerticalContentAlignment="Stretch" />
    </Grid>
</UserControl>
