<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="MCUGLauncher.Avalonia.Views.DownloadView">
    <Grid RowDefinitions="Auto,*,Auto" Margin="20,20,3,20">
        <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="下载" Classes="pageTitle" />
            <TextBlock x:Name="InstanceHint" Grid.Column="1" Classes="muted" VerticalAlignment="Center" />
        </Grid>

        <TabControl Grid.Row="1" Margin="0,12,0,0">
            <TabItem Header="搜索下载">
                <Grid RowDefinitions="Auto,*" Margin="0,8,0,0">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <ComboBox x:Name="CategoryBox" />
                        <TextBox x:Name="QueryBox" Grid.Column="1" Watermark="搜索关键词" Margin="8,0" />
                        <Button x:Name="SearchButton" Grid.Column="2" Content="搜索" Classes="primary" Margin="0,0,10,0" />
                    </Grid>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,10,0,0">
                        <StackPanel Spacing="8">
                            <WrapPanel x:Name="ResultsPanel" Orientation="Horizontal" />
                            <Border x:Name="DetailCard" Classes="card" IsVisible="False">
                                <StackPanel Spacing="8">
                                    <TextBlock x:Name="DetailTitle" Classes="h2" TextWrapping="Wrap" />
                                    <TextBlock x:Name="DetailDescription" TextWrapping="Wrap" />
                                    <TextBlock x:Name="DetailMeta" Classes="muted" TextWrapping="Wrap" />
                                    <TextBlock x:Name="DetailVersionsHint" Classes="muted" TextWrapping="Wrap" />
                                    <Button x:Name="ChooseVersionButton" Content="选择版本并安装" Classes="primary"
                                            HorizontalAlignment="Left" />
                                    <ListBox x:Name="VersionList" Height="180" IsVisible="False" />
                                    <ComboBox x:Name="TargetModeBox" HorizontalAlignment="Left" IsVisible="False" />
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button x:Name="DownloadButton" Content="开始下载" Classes="primary"
                                                IsVisible="False" />
                                        <Button x:Name="BackButton" Content="返回搜索结果" Classes="ghost" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <TabItem Header="原版游戏">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,8,0,0">
                    <StackPanel Spacing="10">
                        <TextBlock Text="搜索并浏览完整 Mojang 版本清单，包括正式版、快照和远古版本。" Classes="muted" />
                        <Grid ColumnDefinitions="*,Auto,Auto">
                            <TextBox x:Name="VanillaQueryBox" Watermark="搜索 Minecraft 版本" />
                            <ComboBox x:Name="VanillaCategoryBox" Grid.Column="1" Margin="8,0" />
                            <Button x:Name="LoadVanillaButton" Grid.Column="2" Content="刷新列表" Classes="ghost" />
                        </Grid>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button x:Name="InstallVanillaButton" Content="安装所选原版" Classes="primary" />
                        </StackPanel>
                        <ListBox x:Name="VanillaList" Height="300" />
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <Button x:Name="PreviousVanillaPageButton" Content="上一页" Classes="ghost" />
                            <TextBlock x:Name="VanillaPageText" Grid.Column="1" Classes="muted"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                            <Button x:Name="NextVanillaPageButton" Grid.Column="2" Content="下一页" Classes="ghost" />
                        </Grid>
                        <TextBlock x:Name="VanillaHint" Classes="muted" TextWrapping="Wrap" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="加载器">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,8,0,0">
                    <StackPanel Spacing="10">
                        <TextBlock Text="为指定 Minecraft 版本安装 Fabric、Quilt、Forge 或 NeoForge。" Classes="muted" />
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <TextBlock Text="游戏版本" VerticalAlignment="Center" />
                            <ComboBox x:Name="LoaderGameBox" Grid.Column="1" Margin="10,0" />
                            <Button x:Name="LoadGameVersionsButton" Grid.Column="2" Content="读取版本" Classes="ghost" />
                        </Grid>
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <TextBlock Text="加载器" VerticalAlignment="Center" />
                            <ComboBox x:Name="LoaderTypeBox" Grid.Column="1" Margin="10,0" />
                            <Button x:Name="LoadLoaderVersionsButton" Grid.Column="2" Content="读取加载器版本" Classes="ghost" />
                        </Grid>
                        <Grid ColumnDefinitions="Auto,*">
                            <TextBlock Text="加载器版本" VerticalAlignment="Center" />
                            <ComboBox x:Name="LoaderVersionBox" Grid.Column="1" Margin="10,0" />
                        </Grid>
                        <Button x:Name="InstallLoaderButton" Content="安装加载器" Classes="primary"
                                HorizontalAlignment="Left" />
                        <TextBlock x:Name="LoaderHint" Classes="muted" TextWrapping="Wrap" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="整合包导入">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,8,0,0">
                    <StackPanel Spacing="10">
                        <TextBlock Text="选择 .mrpack 或 .zip 整合包，先预览再确认导入。" Classes="muted" />
                        <Button x:Name="PickPackButton" Content="选择整合包文件" Classes="ghost" HorizontalAlignment="Left" />
                        <TextBlock Text="也可导入模组、资源包、光影或世界存档；拖入启动器窗口即可检查。" Classes="muted" />
                        <Button x:Name="LocalImportButton" Content="选择本地文件" Classes="ghost" HorizontalAlignment="Left" />
                        <Border x:Name="PackPreviewCard" Classes="card" IsVisible="False">
                            <StackPanel Spacing="10">
                                <TextBlock x:Name="PackTitle" Classes="h2" TextWrapping="Wrap" />
                                <TextBlock x:Name="PackMeta" Classes="muted" />
                                <TextBlock Text="实例名称" FontWeight="SemiBold" />
                                <TextBox x:Name="PackNameBox" Watermark="1–100 个字符" />
                                <TextBlock Text="安装目录" FontWeight="SemiBold" />
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBox x:Name="PackRootBox" Watermark="已存在的游戏目录" />
                                    <Button x:Name="PickPackRootButton" Grid.Column="1" Content="选择" Classes="ghost"
                                            Margin="8,0,0,0" />
                                </Grid>
                                <Button x:Name="ConfirmPackButton" Content="确认导入" Classes="primary"
                                        HorizontalAlignment="Left" />
                            </StackPanel>
                        </Border>
                        <TextBlock x:Name="PackHint" Classes="muted" TextWrapping="Wrap" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <TextBlock x:Name="StatusText" Grid.Row="2" Classes="status" Margin="0,8,0,0" />
    </Grid>
</UserControl>
