<Styles xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Style Selector="Window"><Setter Property="Background" Value="#F3F7FA"/><Setter Property="FontFamily" Value="Microsoft YaHei UI, Segoe UI"/><Setter Property="Foreground" Value="#19374B"/></Style>
  <Style Selector="TextBlock"><Setter Property="Foreground" Value="#19374B"/></Style>
  <Style Selector="Button"><Setter Property="CornerRadius" Value="8"/><Setter Property="Padding" Value="13,9"/><Setter Property="Background" Value="#EAF3F9"/><Setter Property="Foreground" Value="#006DB8"/><Setter Property="BorderBrush" Value="#D5E4EE"/></Style>
  <Style Selector="Button.busy"><Setter Property="Opacity" Value="0.6"/></Style>
  <Style Selector="Button.primary"><Setter Property="Background" Value="#0074BC"/><Setter Property="Foreground" Value="White"/></Style>
  <Style Selector="Button.primary TextBlock"><Setter Property="Foreground" Value="White"/></Style>
  <Style Selector="Button.instance-selected"><Setter Property="BorderBrush" Value="#0074BC"/><Setter Property="BorderThickness" Value="2"/></Style>
  <Style Selector="Button.primary:pointerover /template/ ContentPresenter"><Setter Property="Background" Value="#005F9F"/><Setter Property="TextElement.Foreground" Value="White"/></Style>
  <Style Selector="Button.nav"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="HorizontalAlignment" Value="Stretch"/><Setter Property="HorizontalContentAlignment" Value="Left"/></Style>
  <Style Selector="Button.nav.selected"><Setter Property="Background" Value="#D8ECF8"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
  <Style Selector="TextBox"><Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#D2E2EE"/><Setter Property="CornerRadius" Value="8"/><Setter Property="Padding" Value="10,8"/><Setter Property="MinHeight" Value="36"/></Style>
  <Style Selector="ComboBox"><Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#D2E2EE"/><Setter Property="CornerRadius" Value="8"/><Setter Property="MinHeight" Value="36"/></Style>
  <Style Selector="ProgressBar"><Setter Property="Foreground" Value="#0074BC"/></Style>
  <Style Selector="Button.link"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="5,3"/><Setter Property="FontSize" Value="11"/></Style>
  <Style Selector="Button.account-tab"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="4,0"/><Setter Property="FontSize" Value="10.5"/><Setter Property="HorizontalAlignment" Value="Stretch"/><Setter Property="HorizontalContentAlignment" Value="Center"/></Style>
  <Style Selector="Button.account-tab.active"><Setter Property="Background" Value="White"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
  <Style Selector="Button.top-nav"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Height" Value="34"/><Setter Property="FontSize" Value="12.5"/><Setter Property="Padding" Value="15,0"/></Style>
  <Style Selector="Button.top-nav.selected"><Setter Property="Background" Value="#D8ECF8"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
</Styles>
