<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Avalonia.Controls;assembly=Avalonia.WebView2"
        x:Class="MCUGLauncher.Avalonia.MainWindow"
        Title="MCUG Launcher"
        Width="1200" Height="780"
        MinWidth="960" MinHeight="640"
        Background="#F3F7F9"
        SystemDecorations="None"
        ExtendClientAreaToDecorationsHint="True"
        WindowStartupLocation="CenterScreen">
  <Grid>
    <wv2:WebView2 x:Name="Browser" />
    <Border x:Name="LoadingLayer" Background="#F3F7F9">
      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
        <TextBlock Text="MCUG Launcher" FontSize="24" FontWeight="Bold" Foreground="#1D2B35" HorizontalAlignment="Center" />
        <TextBlock Text="正在加载 Avalonia 预览" FontSize="12" Foreground="#5F717D" Margin="0,10,0,0" HorizontalAlignment="Center" />
      </StackPanel>
    </Border>
  </Grid>
</Window>
