<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="MCUGLauncher.Avalonia.App">
    <Application.Styles>
        <!--
            默认的 FluentTheme 会从 Windows 系统强调色取 Accent，勾选框、列表选中条、
            标签下划线等都会跟着系统主题走。这里把调色板的 Accent 固定成启动器的 #326EA7，
            这些控件就统一用启动器的深蓝，不再受系统设置影响。
        -->
        <FluentTheme>
            <FluentTheme.Palettes>
                <ColorPaletteResources x:Key="Light" Accent="#326EA7" />
                <ColorPaletteResources x:Key="Dark" Accent="#326EA7" />
            </FluentTheme.Palettes>
        </FluentTheme>
        <StyleInclude Source="avares://MCUGLauncher/Styles/Theme.axaml" />
    </Application.Styles>

    <!--
    覆盖 Fluent 的隐式 ScrollBar 主题：无轨道、无箭头，只剩一条圆头细线。
    必须写在 Application.Resources 里——FluentTheme 的主题资源挂在 Application.Styles 上，
    只有 Application.Resources 的查找优先级稳定高于它；写进 Theme.axaml 的 Styles.Resources 会时灵时不灵。
    竖向/横向各一份模板：IsDirectionReversed 只对竖向成立（横向反转会把滑块推到相反方向）。
  -->
    <Application.Resources>
        <ControlTheme x:Key="{x:Type ScrollBar}" TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="0" />

            <Style Selector="^:vertical">
                <Setter Property="Width" Value="6" />
                <Setter Property="Template">
                    <ControlTemplate>
                        <Track Name="PART_Track"
                               Minimum="{TemplateBinding Minimum}"
                               Maximum="{TemplateBinding Maximum}"
                               Value="{TemplateBinding Value, Mode=TwoWay}"
                               DeferThumbDrag="{TemplateBinding ScrollViewer.IsDeferredScrollingEnabled}"
                               ViewportSize="{TemplateBinding ViewportSize}"
                               Orientation="{TemplateBinding Orientation}"
                               IsDirectionReversed="True">
                            <Thumb Name="PART_Thumb" Background="#99B6C0CA">
                                <Thumb.Template>
                                    <ControlTemplate>
                                        <Border Background="Transparent">
                                            <Border Width="4"
                                                    HorizontalAlignment="Right"
                                                    CornerRadius="2"
                                                    Background="{TemplateBinding Background}" />
                                        </Border>
                                    </ControlTemplate>
                                </Thumb.Template>
                            </Thumb>
                        </Track>
                    </ControlTemplate>
                </Setter>
            </Style>

            <Style Selector="^:horizontal">
                <Setter Property="Height" Value="6" />
                <Setter Property="Template">
                    <ControlTemplate>
                        <Track Name="PART_Track"
                               Minimum="{TemplateBinding Minimum}"
                               Maximum="{TemplateBinding Maximum}"
                               Value="{TemplateBinding Value, Mode=TwoWay}"
                               DeferThumbDrag="{TemplateBinding ScrollViewer.IsDeferredScrollingEnabled}"
                               ViewportSize="{TemplateBinding ViewportSize}"
                               Orientation="{TemplateBinding Orientation}">
                            <Thumb Name="PART_Thumb" Background="#99B6C0CA">
                                <Thumb.Template>
                                    <ControlTemplate>
                                        <Border Background="Transparent">
                                            <Border Height="4"
                                                    VerticalAlignment="Bottom"
                                                    CornerRadius="2"
                                                    Background="{TemplateBinding Background}" />
                                        </Border>
                                    </ControlTemplate>
                                </Thumb.Template>
                            </Thumb>
                        </Track>
                    </ControlTemplate>
                </Setter>
            </Style>

            <!-- 悬停加深、拖动更深，颜色变化走 120ms 过渡 -->
            <Style Selector="^ /template/ Thumb#PART_Thumb">
                <Setter Property="Transitions">
                    <Transitions>
                        <BrushTransition Property="Background" Duration="0:0:0.12" />
                    </Transitions>
                </Setter>
            </Style>
            <Style Selector="^:pointerover /template/ Thumb#PART_Thumb">
                <Setter Property="Background" Value="#CC8A97A3" />
            </Style>
            <Style Selector="^ /template/ Thumb:pressed">
                <Setter Property="Background" Value="#E07A8792" />
            </Style>
        </ControlTheme>
    </Application.Resources>
</Application>
