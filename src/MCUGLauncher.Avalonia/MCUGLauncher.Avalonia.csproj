<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>MCUGLauncher</AssemblyName>
    <RootNamespace>MCUGLauncher.Avalonia</RootNamespace>
    <ApplicationIcon>Assets/MCUGLauncher.ico</ApplicationIcon>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
    <DebugType>embedded</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <AvaloniaResource Include="Assets/MCUGLogo.png" />
    <!--
        实例列表的加载器图标取自 PCL2（Plain Craft Launcher 2）的 Images/Blocks/，
        按《PCL 存储库合理使用指南》的“轻度使用”条款引用，仅用于标识加载器类型。
    -->
    <AvaloniaResource Include="Assets/Loaders/Vanilla.png"/>
    <AvaloniaResource Include="Assets/Loaders/Forge.png"/>
    <AvaloniaResource Include="Assets/Loaders/NeoForge.png"/>
    <AvaloniaResource Include="Assets/Loaders/Fabric.png"/>
    <AvaloniaResource Include="Assets/Loaders/OptiFine.png"/>
    <AvaloniaResource Include="Assets\Icons\CloseIcon.svg"/>
    <AvaloniaResource Include="Assets\Icons\DownloadIcon.svg"/>
    <AvaloniaResource Include="Assets\Icons\LaunchIcon.svg"/>
    <AvaloniaResource Include="Assets\Icons\MaximizeIcon.svg"/>
    <AvaloniaResource Include="Assets\Icons\MinimizeIcon.svg"/>
    <AvaloniaResource Include="Assets\Icons\MsIcon.svg"/>
    <AvaloniaResource Include="Assets\Icons\MuaIcon.svg"/>
    <AvaloniaResource Include="Assets\Icons\OfflineModeIcon.svg"/>
    <AvaloniaResource Include="Assets\Icons\ResourcePackIcon.svg"/>
    <AvaloniaResource Include="Assets\Icons\RunningInstancesIcon.svg"/>
    <AvaloniaResource Include="Assets\Icons\ServerIcon.svg"/>
    <AvaloniaResource Include="Assets\Icons\SettingsIcon.svg"/>
    <AvaloniaResource Include="Assets\Icons\OfflineModeIcon.svg"/>
    <AvaloniaResource Include="Assets\Icons\StarIcon.svg"/>
    <AvaloniaResource Include="Assets\Icons\CommunityIcon.svg"/>
    <AvaloniaResource Include="Assets\Icons\DeveloperSettingsIcon.svg"/>
    <AvaloniaResource Include="Assets\Icons\FolderIcon.svg"/>
    <AvaloniaResource Include="Assets\Icons\AboutIcon.svg"/>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../MCUGLauncher.App/MCUGLauncher.App.csproj" />
    <ProjectReference Include="../MCUGLauncher.Core/MCUGLauncher.Core.csproj" />
    <PackageReference Include="Avalonia" Version="11.3.22" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.22" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.22" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.22" />
    <PackageReference Include="Markdown.Avalonia.Tight" Version="11.0.3" />
    <PackageReference Include="WebView2.Avalonia" Version="1.0.3240.44-preview.250526.1" />
    <PackageReference Include="Svg.Controls.Skia.Avalonia" Version="11.3.9.5" />
  </ItemGroup>
</Project>
