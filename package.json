{
  "name": "mcuglauncher",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:demo": "vite --mode demo",
    "build": "tsc && vite build",
    "build:demo": "tsc && vite build --mode demo",
    "dto:generate": "node scripts/split-schemas.mjs && node scripts/annotate-schemas.mjs && node scripts/generate-dto.mjs",
    "dto:check": "npm run dto:generate && git diff --exit-code -- src/types/generated.ts",
    "frontend:pack": "node scripts/pack-frontend.mjs examples/third-party-frontend",
    "preview": "vite preview",
    "tauri": "tauri"
  },
  "dependencies": {
    "@chakra-ui/react": "^3.38.0",
    "@emotion/react": "^11.14.0",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^6.0.2",
    "json-schema-to-typescript": "^16.0.0",
    "typescript": "~6.0.3",
    "vite": "^8.0.16"
  }
}
